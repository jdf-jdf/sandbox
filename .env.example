# Copy to .env and fill in. run.py loads this automatically (no dotenv needed).
# NEVER commit .env — it is in .gitignore.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail SMTP ---
# This is a Google APP PASSWORD, not your normal password.
# Get one: myaccount.google.com -> Security -> 2-Step Verification -> App passwords
# It looks like: abcd efgh ijkl mnop  (spaces are fine, they get stripped)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where outbound goes. Set to your own address to exercise the full send path
# without contacting anyone real; unset it to send to each row's address.
SEND_TO=you@gmail.com

# --- attribution ---
# Key for the HMAC behind every tracking token. Leave it unset and the machine
# falls back to a constant, which is fine for a sample and wrong for anything
# real: the tokens become guessable, and a token that appears in a public URL
# or a web log is then enough to enumerate who was written to. Any long random
# string will do -- `openssl rand -hex 32` is one way to get one.
ATTRIBUTION_SECRET=
